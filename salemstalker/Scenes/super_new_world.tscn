[node name="Finn" parent="Brittlebay Village/Villagers" instance=ExtResource("28_51fmf")]
transform = Transform3D(0.9928366, 0, -0.119478375, 0, 1, 0, 0.119478375, 0, 0.9928366, 7.603607, 1.9490459, -29.647156)
visible = false
script = ExtResource("37_8w7un")
NPCName = "Finn"
InitialDialogue = "Master Inquisitor, I've got some valuable information you may want to hear."
QuestDialogue = Array[String](["After we had to move from our past village, we left a lot of valuable things behind.", "I heard of a useful tool somewhere in Willow-Mire. You may want to check it out."])
AcceptedDialogue = Array[String](["Be careful when looking around the town. It's changed since the last time we were there. Be on your guard."])
IgnoredDialogue = Array[String](["You may want to reconsider. It could help you further down the road."])
WaitingDialogue = "I still wonder what that tool could be."
PostDoneDialogue = "So the tool was some caltrops? Sounds useful."
QuestTitle = "Find the hidden weapon somewhere in the swamp island village"
QuestGoal = "0/1"

[node name="Matthew" parent="Brittlebay Village/Villagers" instance=ExtResource("28_51fmf")]
transform = Transform3D(0, 0, 0.9999999, 0, 1, 0, -0.9999999, 0, 0, -26.992249, 2.0682554, 0.98553467)
script = ExtResource("38_50yta")
NPCName = "Matthew"
InitialDialogue = ""
QuestDialogue = Array[String](["Young man, are you alright? You don't look too well...", "From the looks of it, you seem to be an Inquisitor... from the Kingdom's capital!?", "Please excuse my rudeness Master Inquisitor, I only meant to see if you weren't in any harm. You seem to be alright from the looks of it.", "It's such a relief that the King sent over Inquisitors. The island of Saltus is in dire need of your help.", "Please, assist some of my village's townsfolk in their needs, then you'll understand more of what's going on here.", "Oh, and one more thing, Master Inquisitor. Welcome to Brittlebay village. My name is Matthew, and I am the chief of this village. May Her holy light shine upon us all. "])
AcceptedDialogue = Array[String]([])
IgnoredDialogue = Array[String]([])
WaitingDialogue = "Please help out the townsfolk. We need your help."

