[node name="Dillon" parent="Elderstraud Village/Villagers" instance=ExtResource("28_51fmf")]
transform = Transform3D(-0.41043234, 0, 0.9118909, 0, 1, 0, -0.9118909, 0, -0.41043234, 15.948669, 0.74256444, 20.083603)
script = ExtResource("33_ne20o")
NPCName = "Dillon"
InitialDialogue = "This whole island is doomed if nothing is done."
QuestDialogue = Array[String](["Lord Inquisitor. It's good to see you here in Elderstraud—no, on this island. We're all in desperate need of your help.", "If you haven't noticed, this island has been entrapped by eternal darkness. This event was prophesied to occur, and now it's upon us. It's said that the God of Darkness, Kyron, is what's behind it all.", "This amount of darkness means that he's somewhere on this island. Please, end this once and for all. Kill the God of Darkness, Kyron."])
AcceptedDialogue = Array[String](["Thank you. The fate of the island is in your hands."])
IgnoredDialogue = Array[String](["You're making a mistake Lord Inquisitor. Please, reconsider and save the island."])
WaitingDialogue = "I hope you find where Kyron is hiding. You're our last hope."
QuestTitle = "Defeat Kyron, the God of Darkness"
QuestGoal = "0/1"

