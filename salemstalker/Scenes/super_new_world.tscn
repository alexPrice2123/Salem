[node name="Isaac" parent="Elderstraud Village/Villagers" instance=ExtResource("28_51fmf")]
transform = Transform3D(-0.41043234, 0, 0.9118909, 0, 1, 0, -0.9118909, 0, -0.41043234, -9.212402, 0.74256444, 9.643372)
script = ExtResource("69_ay51x")
NPCName = "Isaac"
InitialDialogue = "If I can get more samples, maybe there can be a way to find the source."
QuestDialogue = Array[String](["Master Inquisitor! Just the person I was hoping of running into. May I have just a moment of your time? It's regarding the cultists.", "I believe I can pin point exact locations of the cultist's largest threats if you can get me some samples.", "I'll need a few of the resources that you recover from their corpses, once you've defeated them of course. Do you think you can retrieve some for me?"])
AcceptedDialogue = Array[String](["Great! I'll be here whenever you get those resources."])
IgnoredDialogue = Array[String](["Well, it'll be harder finding them without my help."])
WaitingDialogue = "Come back to me once you got the amount I need. "
DoneDialogue = Array[String](["Yes! These are perfect! Give me a moment.", ". . . . . .", "Here it is! I've marked the places on your map. Make sure you hit them where it hurts Inquisitor! "])
PostDoneDialogue = "These Cultist hearts are interesting indeed!"
QuestTitle = "Discover enough resource samples for the scholar."
QuestGoal = "Hearts: 0/2, Wounded Ooze: 0/3, Sprouts: 0/5, Scorched Flesh: 0/6"

