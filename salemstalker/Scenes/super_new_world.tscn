[node name="Kat" parent="Brittlebay Village/Villagers" instance=ExtResource("28_51fmf")]
transform = Transform3D(0.9928366, 0, -0.119478375, 0, 1, 0, 0.119478375, 0, 0.9928366, -0.14904785, 1.9490459, -23.890564)
script = ExtResource("29_my6m3")
NPCName = "Kat"
InitialDialogue = "Oh my sweet little babies! Please come back to me!"
QuestDialogue = Array[String](["Lord Inquisitor sir! Won't you help an old woman out? I've lost my young and dearest kitties, Taz, Bridger, Rogue, and Gnocchi.", " I last saw them approach some strange individuals in purple robes outside of the village.", "Would you please find them and bring them back home? "])
AcceptedDialogue = Array[String](["Oh thank you! Please make sure they come back safely."])
IgnoredDialogue = Array[String](["Oh dear. Maybe they'll come back on their own some day..."])
WaitingDialogue = "Have you found my babies yet?"
DoneDialogue = Array[String](["Oh thank you Lord Inquisitor! Don't ever leave me again my cuties. Mama Kat will protect you here.  "])
PostDoneDialogue = "Ahhh! No biting Bridger. "
QuestTitle = "Find Kat's lost cats in the woods near Brittlebay village"
QuestGoal = "0/4"

