[node name="Christopher" parent="Elderstraud Village/Villagers" instance=ExtResource("28_51fmf")]
transform = Transform3D(-0.41043234, 0, 0.9118909, 0, 1, 0, -0.9118909, 0, -0.41043234, -17.01892, 0.74256444, -5.5045166)
script = ExtResource("68_2n1ai")
NPCName = "Christopher"
InitialDialogue = "It seems Lukas was right about those shrines."
QuestDialogue = Array[String](["Well, well, well. It seems like Inquisitor finally found our town. Welcome to Elderstraud.", "I heard of your arrival from one of my friends in Brittlebay village. Their name is Lukas, and they've made some interesting discoveries that I've taken a look at.", "They said that the cultists have been setting up shrines around their village, so I decided to take a look around ours.", "My suspicion was correct, and I saw some being set up near our village.", "Please Master Inquisitor. Assist this helpless town by destroying those shrines. "])
AcceptedDialogue = Array[String](["Thank you so much. This town will forever be in your debt.", "I marked the locations of those shrines on your map. Come back to me once those shrines have been vanquished. "])
IgnoredDialogue = Array[String](["Please reconsider. Those shrines must be destroyed."])
WaitingDialogue = "Look on your map for those shrines. "
DoneDialogue = Array[String](["Well done Master Inquisitor! I believe these shrines were tougher than the ones near Brittlebay village. Thank you again."])
PostDoneDialogue = "We feel safer now. Thank you. "
QuestTitle = "Destroy the Cultist's shrines around Elderstraud village"
QuestGoal = "0/3"

