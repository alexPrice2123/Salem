[node name="Alexander" parent="Elderstraud Village/Villagers" instance=ExtResource("28_51fmf")]
transform = Transform3D(-0.41043234, 0, 0.9118909, 0, 1, 0, -0.9118909, 0, -0.41043234, -0.93218994, 0.74256444, -6.749817)
script = ExtResource("67_3yls0")
NPCName = "Alexander"
InitialDialogue = "I can't go back there! Someone else needs to do it!"
QuestDialogue = Array[String](["You there! You seem quite strong. I just came back from scouting for any potential dangers and saw a bunch of the cultists's creations in the swamp east of our village.", "One of them lunged right at my leg and tried eating it!", "Please, could you go investigate them further and possibly deal with them? "])
AcceptedDialogue = Array[String](["Man, I really appreciate it. Those guys are too dangers for any of us to encounter with.", "I trust you'll get it all settled with. Reach back to me if you were successful. "])
IgnoredDialogue = Array[String](["Maybe I'll try getting a scouting party together. "])
WaitingDialogue = "Let me know if you were successful. "
DoneDialogue = Array[String](["Wow! I can't believe you were able to do it on your own. Thank you so much. "])
PostDoneDialogue = "I'll try to go out and scouting again soon. "
QuestTitle = "Investigate the strange disturbances in the swamp East of Elderstraud village and deal with any threats."
QuestGoal = "0/10 threats killed "

